{
  "name": "finalpingapp",
  "version": "1.0.12",
  "description": "FinalPingTracker Desktop - Real-time aircraft tracking and notifications",
  "author": "FinalPing",
  "homepage": ".",
  "main": "src/main/main.js",
  "scripts": {
    "start": "concurrently \"npm run start:react\" \"wait-on http://localhost:3000 && npm run start:electron\"",
    "start:react": "react-scripts start",
    "start:electron": "electron .",
    "build": "react-scripts build",
    "copy:electron": "node -e \"const fs=require('fs'); fs.copyFileSync('src/main/main.js','build/electron.js'); fs.copyFileSync('src/main/preload.js','build/preload.js'); fs.copyFileSync('src/main/tracker_bridge.js','build/tracker_bridge.js'); console.log('✅ Electron files copied')\"",
    "build:electron": "electron-builder",
    "build:tracker": "python3 build_tracker.py || python build_tracker.py",
    "package": "npm run build && npm run copy:electron && npm run build:electron",
    "package:full": "npm run build && npm run copy:electron && npm run build:tracker && npm run build:electron"
  },
  "build": {
    "appId": "com.finalpingapp.tracker",
    "productName": "FinalPing",
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "../FinalPing-Builds"
    },
    "extraMetadata": {
      "main": "build/electron.js"
    },
    "publish": {
      "provider": "github",
      "owner": "ShermR6",
      "repo": "aircraft-tracker-desktop",
      "releaseType": "release"
    },
    "nsis": {
      "license": "assets/license.rtf",
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "FinalPingSetup.exe",
      "extraResources": [
        {
          "from": "resources/tracker.exe",
          "to": "tracker.exe"
        }
      ]
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": ["universal"]
      },
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "artifactName": "FinalPingSetup.dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "asar": true
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "axios": "^1.6.2",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.3.6",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
